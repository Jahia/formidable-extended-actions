{
	"name": "formidable-extended-actions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"formidable-content",
		"formidable-salesforce",
		"formidable-hubspot",
		"formidable-efficy"
	],
	"scripts": {
		"build": "yarn check:forms && yarn workspaces foreach --all --topological run build",
		"test": "yarn workspaces foreach --all run test",
		"lint": "yarn workspaces foreach --all run lint",
		"check:forms": "node scripts/check-editor-forms.mjs"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^2.3.13",
		"@eslint/js": "^9.39.2",
		"eslint": "^9.39.2",
		"globals": "^16.5.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.50.0"
	},
	"packageManager": "yarn@4.12.0"
}
