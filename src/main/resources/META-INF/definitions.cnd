// Formidable Extended Actions: the node types of every form action this module ships, in ONE file.
// Each namespace is declared here, once: the engine merges every .cnd of the module into one definition, and a prefix
// spelled twice leaves the module installed and never started. The families below keep the node type and property
// names they had as separate modules.

<nt = 'http://www.jcp.org/jcr/nt/1.0'>
<mix = 'http://www.jcp.org/jcr/mix/1.0'>
<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<fmdbmix = 'http://www.jahia.org/jahia/fmdb/mix/1.0'>
<fmdbacc = 'http://www.jahia.org/jahia/fmdbacc/nt/1.0'>
<fmdbaccmix = 'http://www.jahia.org/jahia/fmdbacc/mix/1.0'>
<fmdbcnt = 'http://www.jahia.org/jahia/fmdbcnt/nt/1.0'>
<fmdbsfdc = 'http://www.jahia.org/jahia/fmdbsfdc/nt/1.0'>
<fmdbhs = 'http://www.jahia.org/jahia/fmdbhs/nt/1.0'>
<fmdbeff = 'http://www.jahia.org/jahia/fmdbeff/nt/1.0'>

// ====================================================================================================================
// Accounts family (org.jahia.modules.formidable.accounts): Create account and Sign in
// ====================================================================================================================

// Formidable Accounts: self-registration and sign-in of site visitors from a Formidable form.
// Both actions read their values from the form's fields BY NAME (the node name of the field, picked from a list of
// the enclosing form's fields) and need a password field (fmdbmix:sensitiveField, for instance fmdbext:password of
// formidable-extended-inputs): only an action that declares it consumes sensitive values receives one.
// Neither action carries fmdbmix:readOnlyCompatibleAction: both write (the user, the session).

// Marks the user node of an account that was created locked and awaits its activation e-mail. Applied by the
// Create account action when activation is required, removed by the verification servlet; the token itself is never
// stored, only its SHA-256 hash, and the account stays locked (j:accountLocked) until the mixin is removed.
[fmdbaccmix:pendingActivation] mixin
 - activationTokenHash (string) hidden indexed=no
 - activationExpires (date) hidden indexed=no
 - activationRedirect (string) hidden indexed=no

// Creates the account of the visitor who submitted the form: user name from the e-mail, password hashed by the
// platform, optional group, optional sign-in, optional e-mail activation. The form MUST be captcha protected unless
// the operator allowed otherwise (org.jahia.modules.formidable.accounts.cfg, requireCaptcha).
[fmdbacc:createAccountAction] > jnt:content, fmdbmix:formAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbacc_createAccountAction') autocreated i18n
 - emailField (string, choicelist[formidableAccountsFields='email']) mandatory indexed=no
 - passwordField (string, choicelist[formidableAccountsFields='sensitive']) mandatory indexed=no
 - firstNameField (string, choicelist[formidableAccountsFields='any']) indexed=no
 - lastNameField (string, choicelist[formidableAccountsFields='any']) indexed=no
 - group (string, choicelist[formidableAccountsGroups]) indexed=no
 - signIn (boolean) = true autocreated indexed=no
 - redirectPage (weakreference, picker[type='page'])
 - redirectParameter (string) indexed=no
 - passwordPattern (string) indexed=no
 - activationRequired (boolean) = false autocreated indexed=no
 - activationHours (long) = 48 autocreated indexed=no
 - activationPage (weakreference, picker[type='page'])
 - activationSubject (string) i18n indexed=no
 - activationMessage (string, textarea) i18n indexed=no
 - pendingMessage (string) i18n indexed=no

// Signs the visitor in through the platform's authentication service (a Jahia login: the login event fires, so
// jExperience merges the visitor's anonymous profile into the user's). A failure always reads the same.
[fmdbacc:signInAction] > jnt:content, fmdbmix:formAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbacc_signInAction') autocreated i18n
 - loginField (string, choicelist[formidableAccountsFields='any']) mandatory indexed=no
 - passwordField (string, choicelist[formidableAccountsFields='sensitive']) mandatory indexed=no
 - redirectPage (weakreference, picker[type='page'])
 - redirectParameter (string) indexed=no
 - failureMessage (string) i18n indexed=no

// ====================================================================================================================
// Content family (org.jahia.modules.formidable.content): Create content
// ====================================================================================================================

// Formidable Content: the "Create content" form action. A signed-in user's submission becomes a content node of a
// chosen type (the form's fields fill its properties), the uploaded files become jnt:file nodes the content references,
// and both are published. Everything is configured here, on the action node; nothing is configured in a file.
// The action refuses guests, and writes only in a folder the submitter's own live session can read (the subfolder named
// by their group). It carries no fmdbmix:readOnlyCompatibleAction: it writes.
//
// What fills what is ONE JSON document, `mapping`, written by the ContentMapping selector type of the Content Editor
// (never typed by hand): {"version":1,"rows":[{"target":"content"|"file","property":"<name>","source":"field"|"files"|
// "constant"|"submitter"|"organization"|"page", ...}]}. A field row names its form field by node id, field key and name
// (a renamed field still resolves); a constant row carries "values". jcr:title from a field also names the node. The
// companion-file rule stays a line of text: requiredPairs  dependentField<-field:mimePattern  e.g. captions<-media:video/*
[fmdbcnt:createContentAction] > jnt:content, fmdbmix:formAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbcnt_createContentAction') autocreated i18n
 - contentType (string, choicelist[formidableContentTypes]) mandatory indexed=no
 - parentFolder (weakreference) mandatory
 - mapping (string) indexed=no
 - filesFolder (weakreference, picker[type='folder'])
 - fileMixin (string, choicelist[formidableContentFileMixins]) indexed=no
 - groupPrefix (string) indexed=no
 - requiredPairs (string) multiple indexed=no
 - pairRefusalMessage (string) i18n indexed=no
 - publish (boolean) = true autocreated indexed=no

// ====================================================================================================================
// Salesforce (fmdbsfdc) family (org.jahia.modules.formidable.salesforce)
// ====================================================================================================================

// Creates (or upserts) a Salesforce Lead from the submitted form values.
// The Salesforce connection (instance URL, consumer key, private key) lives in operator
// configuration (org.jahia.modules.formidable.salesforce-<id>.cfg); JCR only holds its id.
// fieldMapping is a JSON document authored by the SalesforceLeadMapping selector type.
[fmdbsfdc:createLeadAction] > jnt:content, fmdbmix:formAction, fmdbmix:readOnlyCompatibleAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbsfdc_createLeadAction') autocreated i18n
 - connectionId (string, choicelist[formidableSfdcConnections]) mandatory indexed=no
 - fieldMapping (string) indexed=no
 - duplicateStrategy (string, choicelist[resourceBundle]) = 'create' autocreated indexed=no < 'create', 'upsertByEmail'
 - failSubmissionOnError (boolean) = true autocreated indexed=no

// ====================================================================================================================
// HubSpot (fmdbhs) family (org.jahia.modules.formidable.hubspot)
// ====================================================================================================================

// Creates (or upserts) a HubSpot Contact from the submitted form values.
// The HubSpot connection (API base URL, private app token) lives in operator configuration
// (org.jahia.modules.formidable.hubspot-<id>.cfg); JCR only holds its id.
// fieldMapping is a JSON document authored by the HubspotContactMapping selector type.
[fmdbhs:createContactAction] > jnt:content, fmdbmix:formAction, fmdbmix:readOnlyCompatibleAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbhs_createContactAction') autocreated i18n
 - connectionId (string, choicelist[formidableHubspotConnections]) mandatory indexed=no
 - fieldMapping (string) indexed=no
 - duplicateStrategy (string, choicelist[resourceBundle]) = 'create' autocreated indexed=no < 'create', 'upsertByEmail'
 - failSubmissionOnError (boolean) = true autocreated indexed=no

// ====================================================================================================================
// Efficy (fmdbeff) family (org.jahia.modules.formidable.efficy)
// ====================================================================================================================

// Creates an Efficy e-deal Opportunity from the submitted form values.
// The Efficy connection (server, application context, API token, field catalog) lives in operator
// configuration (org.jahia.modules.formidable.efficy-<id>.cfg); JCR only holds its id.
// fieldMapping is a JSON document authored by the EfficyOpportunityMapping selector type.
[fmdbeff:createOpportunityAction] > jnt:content, fmdbmix:formAction, fmdbmix:readOnlyCompatibleAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbeff_createOpportunityAction') autocreated i18n
 - connectionId (string, choicelist[formidableEfficyConnections]) mandatory indexed=no
 - fieldMapping (string) indexed=no
 - failSubmissionOnError (boolean) = true autocreated indexed=no
